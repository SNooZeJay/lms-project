APP_NAME="BSIT Academic LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=lms
DB_USERNAME=lms_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail. MAIL_MAILER=log writes messages to storage/logs instead of sending them,
# which is the safe default: a fresh checkout cannot send mail by accident, and
# nothing is spent or leaked while the SMTP details are still being filled in.
MAIL_MAILER=log
# To send for real, set MAIL_MAILER=smtp and use the settings below.
# MAIL_SCHEME=smtp on port 587 starts TLS by itself. The value is "smtp" or
# "smtps" only; the older "tls" spelling is rejected by the mailer.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME and MAIL_PASSWORD are the Gmail address and a 16 character app
# password. The app password is a real secret: put it in your .env, never here.
# Gmail requires 2-Step Verification before it will issue one.
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS must be the same address as MAIL_USERNAME. Gmail rejects or
# rewrites a From header for an account it has not authenticated, so a different
# value here does not work and only fails in production.
# MAIL_FROM_ADDRESS=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="lms@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Payments. Leave these empty in development and the checkout refuses to run.
# In production set PAYMONGO_ENABLED=true and use live-mode keys.
PAYMONGO_ENABLED=false
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# false while using test keys, true while using live keys.
PAYMONGO_LIVEMODE=false
# Methods shown on the hosted checkout page. Cards are excluded on purpose.
# Maya is paymaya, not maya.
PAYMONGO_PAYMENT_METHODS=qrph,gcash,paymaya

# Local Administrator bootstrap. Keep the secret path outside the repository.
OWNER_NAME=
OWNER_EMAIL=
OWNER_SECRET_PATH=
