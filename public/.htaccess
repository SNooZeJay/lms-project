<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Refuse dotfiles and dot-directories outright.
    #
    # The front controller below serves any file that already exists in this
    # directory, so nothing but a deliberate rule stands between a file dropped
    # here and a stranger downloading it. The contents of this directory are
    # index.php, .htaccess, favicon.png, robots.txt, images/, and build/, and
    # none of them begin with a dot, so this cannot reject a real request.
    #
    # /.well-known is excluded on purpose: it is not a dotfile and it is where a
    # certificate authority is told to fetch proof for a domain, so blocking it
    # would quietly break issuing a certificate.
    RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

    # The same argument applies to the project files that are not dotfiles.
    # None of these belong in a document root, and refusing each is a cheap
    # second line of defence if one is ever copied here by accident.
    RewriteRule "(^|/)(composer\.(json|lock)|package(-lock)?\.json|artisan|server\.php|\.env.*|.*\.(pem|key|crt|p12|pfx|ppk)|credentials.*|secrets.*|id_rsa.*)$" - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Long lived caching for the built assets and the static images.
#
# These are served by the web server straight off disk, so no PHP ever sees them
# and a middleware cannot set a header on them. That is the whole reason this
# block exists: a Cache-Control set in the application is silently ignored for
# every file in build/, which is where the stylesheet and the script live.
#
# The year is safe because the filenames carry a content hash. app-CcnLoUiz.css
# is a different file the moment one byte of the source changes, so a browser
# holding last week's copy can never be handed a stale one.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|png|jpe?g|gif|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # index.php is the same URL for every version of the application, so it can
    # never be held for long. A minute of freshness with a revalidate tail means
    # following a link twice in a minute costs nothing, and everyone else pays
    # for a 304 rather than a whole document.
    <FilesMatch "index\.php$">
        Header set Cache-Control "public, max-age=60, stale-while-revalidate=300"
    </FilesMatch>
</IfModule>